[Unit]
Description=PTS native account progress and job events
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
ExecStart=/usr/bin/python3 /opt/pts-native/native_companion.py
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=pts-native
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/DATA/PTSlibrary
ReadWritePaths=/var/lib/pts-native
MemoryMax=128M
TasksMax=48
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
